{
  "expo": {
    "name": "Flyerx",
    "slug": "flyerx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "flyerx",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flyerx.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3b82f6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.flyerx.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir $(PRODUCT_NAME) usar Face ID para autenticação."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
