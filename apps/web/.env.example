# ===== Flyerx Web - Configurações =====
# Copie este arquivo para .env.local e configure os valores

# =====================================================
# VARIÁVEIS CLIENT-SIDE (NEXT_PUBLIC_)
# Estas são expostas no browser - NÃO colocar segredos!
# =====================================================

# URL da API Laravel para autenticação
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# URL da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo mock (true para dev sem backend)
NEXT_PUBLIC_MOCK_API=false

# =====================================================
# VARIÁVEIS SERVER-SIDE (sem NEXT_PUBLIC_)
# Estas são SEGURAS - só acessíveis nas API Routes
# =====================================================

# === Eulen API ===
EULEN_API_URL=https://depix.eulen.app/api
EULEN_API_TOKEN=

# === Backend LWK (Python) ===
# URL interna do microserviço de saques
LWK_SERVICE_URL=http://localhost:8000

# Usar backend LWK para saques (true = com taxa de parceiro)
USE_BACKEND_LWK=true

# === Chaves de autenticação interna ===
# Mesma chave configurada no Laravel/Python
INTERNAL_API_KEY=

# Gateway Key para chamar o Laravel
GATEWAY_API_KEY=
