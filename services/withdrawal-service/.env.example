# ===== Flyerx Backend - Configurações =====
# Copie este arquivo para .env e configure os valores

# ===== Ambiente =====
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=sua-chave-secreta-aqui-mudar-em-producao

# Servidor
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== Banco de Dados PostgreSQL =====
# Railway fornece esta variável automaticamente como DATABASE_URL
# Formato: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://flyerx:flyerx@localhost:5432/flyerx

# ===== Redis (opcional - para workers em background) =====
REDIS_URL=redis://localhost:6379/0

# ===== LWK - Liquid Wallet Kit =====
# ATENÇÃO: Mnemonic é EXTREMAMENTE SENSÍVEL!
# Em produção, NUNCA commitar! Usar variáveis de ambiente do Railway.
# Para mainnet: LWK_NETWORK=liquid e LWK_ELECTRUM_URL=blockstream.info:995
LWK_NETWORK=liquid-testnet
LWK_ELECTRUM_URL=blockstream.info:465
LWK_MNEMONIC=your twelve word mnemonic phrase here for liquid wallet never share this

# ===== API Eulen (Pix2Depix) =====
EULEN_API_URL=https://depix.eulen.app/api
EULEN_API_TOKEN=seu-token-jwt-da-eulen
EULEN_MOCK_MODE=false

# ===== Taxas do Parceiro (Flyerx) =====
# 1.5% de taxa sobre saques
PARTNER_WITHDRAW_FEE_PERCENT=0.015
PARTNER_WITHDRAW_FEE_FIXED_CENTS=0
PARTNER_WITHDRAW_FEE_MIN_CENTS=50

# ===== Worker =====
WITHDRAWAL_POLL_INTERVAL_SECONDS=10
WITHDRAWAL_EXPIRATION_HOURS=1

# ===== CORS =====
# Em produção, usar o domínio real (ex: https://app.flyerx.com.br)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== Autenticação Interna =====
# Chave para comunicação Laravel <-> Python
# Gerar com: openssl rand -hex 32
INTERNAL_API_KEY=flyerx-internal-dev-key-2024
