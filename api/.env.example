APP_NAME=Flyerx
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=flyerx
DB_USERNAME=flyerx
DB_PASSWORD=secret

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache
CACHE_STORE=redis
CACHE_PREFIX=flyerx_

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue
QUEUE_CONNECTION=redis

# Mail (Mailpit for development)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@flyerx.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend URL (for email links)
APP_FRONTEND_URL=http://localhost:3000

# Hashing
HASH_DRIVER=argon2id

# ===========================================
# Application Specific
# ===========================================

# JWT Authentication
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=10080

# Two-Factor Authentication
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ISSUER="${APP_NAME}"

# Encryption (for sensitive data at rest)
ENCRYPTION_KEY=

# ===========================================
# Eulen Payment Provider
# ===========================================
EULEN_ENABLED=true
EULEN_BASE_URL=https://depix.eulen.app/api
EULEN_API_TOKEN=
EULEN_WEBHOOK_SECRET=
EULEN_TIMEOUT=30
EULEN_RETRY_ATTEMPTS=3

# Circuit Breaker
EULEN_CB_THRESHOLD=5
EULEN_CB_RECOVERY_TIME=30

# ===========================================
# Operational Limits (cents)
# ===========================================
DEPOSIT_MIN_AMOUNT=100
DEPOSIT_MAX_AMOUNT=10000000
WITHDRAWAL_MIN_AMOUNT=500
WITHDRAWAL_MAX_AMOUNT=5000000
WITHDRAWAL_APPROVAL_THRESHOLD=100000

# ===========================================
# Security
# ===========================================
RATE_LIMIT_API=100
RATE_LIMIT_AUTH=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=300

# Gateway Key (frontend/Vercel deve enviar essa chave)
# Gere com: openssl rand -base64 32
GATEWAY_API_KEY=

# CORS - domínios permitidos (separados por vírgula)
# Ex: https://flyerx.vercel.app,https://app.flyerx.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===========================================
# Feature Flags
# ===========================================
FEATURE_KYC_REQUIRED=true
FEATURE_2FA_REQUIRED=false
FEATURE_DEVICE_TRACKING=true
FEATURE_EULEN_WEBHOOK_VALIDATION=false
